# The document's own controls, which its script adds. Conventions: docs/ARCHITECTURE.md,
# "Strings and languages".

# The button on a code block that copies its code, and what it says for a moment after.
doc-copy = Copy
doc-copied = Copied
doc-copy-failed = Couldn't copy
# In place of a picture from the internet, until the user chooses to show them.
doc-remote-image = Picture from the internet, not shown
# In place of a picture that isn't there and has no description of its own.
doc-missing-image = Picture not found
# The toggle under a diagram that shows the text it's drawn from.
doc-show-source = Show source
# Above a diagram that couldn't be drawn, whose text is shown instead.
doc-diagram-failed = This diagram couldn't be drawn. Its source is below.
